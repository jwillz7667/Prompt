# Backend API
NEXT_PUBLIC_API_URL=https://backend-production-d7487.up.railway.app/api/v1

# Apple Sign-In (Web Service ID)
NEXT_PUBLIC_APPLE_CLIENT_ID=com.res.promptomizer.web
APPLE_TEAM_ID=487LC4H9U4
APPLE_KEY_ID=xxx
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Stripe (web Premium subscription). Leave unset to disable web checkout:
# the upgrade page then shows "unavailable" and checkout returns 503.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring $9.99/month price for Promptomize Premium
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx
# Optional, comma-separated: retired Pro/annual price IDs whose subscribers
# keep Premium until they lapse. The old NEXT_PUBLIC_STRIPE_PRICE_* vars are
# still read for the same purpose if they are set.
STRIPE_LEGACY_CONSUMER_PRICE_IDS=

# Internal webhook secret for backend communication
BACKEND_WEBHOOK_SECRET=xxx

# App
NEXTAUTH_URL=https://promptomize.app
NEXTAUTH_SECRET=xxx
