# =============================================================================
# Promptomize Web — .gitignore
# Layered on top of the repository-root .gitignore.
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js
.next/
out/
next-env.d.ts

# Build / Production
build/
dist/

# Vercel
.vercel

# Environment
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.eslintcache
.prettiercache
.swc/
.turbo/

# Test coverage
coverage/
.nyc_output/

# PWA generated assets (regenerated by next-pwa)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map

# Tailwind
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
