# =============================================================================
# Promptomize — Root .gitignore
# Covers macOS, Xcode, Swift, Node.js, Next.js, Prisma, fastlane, IDEs, secrets.
# Per-package .gitignores layer additional rules in backend/, web/, chatgpt-app/.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & credentials  (NEVER commit any of these)
# -----------------------------------------------------------------------------
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env
!.env.example

# Apple App Store / Push / Sign In keys
fastlane/AuthKey*.p8
fastlane/api_key.json
*.p8
*.mobileprovision
*.cer
*.certSigningRequest

# Firebase / Google service files (template only, real files are gitignored)
Prompt/GoogleService-Info.plist
GoogleService-Info.plist

# Generic key/secret patterns
*.pem
*.key
!**/public.key
*_rsa
*_ed25519
secrets/
private/

# -----------------------------------------------------------------------------
# OS-generated files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# IDE / Editors
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example
*.swp
*.swo
*~
.fleet/
*.iml
.project
.classpath
.settings/
.history/
.ionide/

# -----------------------------------------------------------------------------
# Xcode / Swift
# -----------------------------------------------------------------------------
build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
xcuserdata/
*.swiftpm
.swiftpm/
.build/
Packages/
Package.pins
Package.resolved
*.xcscheme
!*.xcodeproj/xcshareddata/xcschemes/*.xcscheme

# Swift Package Manager local state
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# CocoaPods (not used but keep guarded)
Pods/
*.xcworkspace
!default.xcworkspace

# Carthage (not used but keep guarded)
Carthage/Build

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/screenshots/**/*.jpg
fastlane/test_output
fastlane/sigh/
fastlane/*.cer
fastlane/*.p12

# -----------------------------------------------------------------------------
# Node.js / Next.js / TypeScript
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# Build outputs
dist/
build/
out/
.next/
.turbo/
.swc/
.cache/
.parcel-cache/

# Generated TypeScript declarations
*.tsbuildinfo
next-env.d.ts

# Test coverage
coverage/
.nyc_output/
*.lcov
junit.xml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Optional REPL history
.node_repl_history

# -----------------------------------------------------------------------------
# Next.js / Vercel
# -----------------------------------------------------------------------------
.vercel
.next/
web/.next/
web/next-env.d.ts

# PWA generated files (regenerated on build)
web/public/sw.js
web/public/sw.js.map
web/public/workbox-*.js
web/public/workbox-*.js.map
web/public/worker-*.js
web/public/worker-*.js.map

# -----------------------------------------------------------------------------
# Prisma
# -----------------------------------------------------------------------------
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/migrations/dev.db*

# -----------------------------------------------------------------------------
# Docker / Containers
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.tgz
*.tsbuildinfo
.tmp/
tmp/
temp/
*.bak
*.orig
*.tmp
.eslintcache
.stylelintcache
.prettiercache

# Sentry
.sentryclirc

# -----------------------------------------------------------------------------
# Project-specific build artifacts (top-level)
# -----------------------------------------------------------------------------
build/

# -----------------------------------------------------------------------------
# AI-agent guidance files (kept locally, not part of the public repo history)
# -----------------------------------------------------------------------------
CLAUDE.md
AGENTS.md
**/CLAUDE.md
**/AGENTS.md
.claude/

