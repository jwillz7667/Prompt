# =============================================================================
# .dockerignore — keep the build context small and avoid leaking secrets.
# =============================================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
dist
build
coverage
.tsbuildinfo
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example

# Version control
.git
.gitignore
.gitattributes
.github

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Documentation (not needed at runtime)
README.md
CHANGELOG.md
docs/

# Tests / linting (not needed in the production image)
*.test.ts
*.spec.ts
__tests__
.eslintcache
.prettiercache

# Local Prisma artifacts
prisma/*.db
prisma/*.db-journal
