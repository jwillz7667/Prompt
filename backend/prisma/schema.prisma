generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  GRACE_PERIOD
}

// ============================================================================
// API SUBSCRIPTION ENUMS - For Enterprise API Access
// ============================================================================

enum ApiTier {
  API_FREE        // 100 requests/month, free
  API_STARTER     // 1,000 requests/month, $29/month
  API_PRO         // 10,000 requests/month, $99/month
  API_ENTERPRISE  // Unlimited, custom pricing
}

enum ApiSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

// ============================================================================
// USER MANAGEMENT - Scalable for millions of users
// ============================================================================

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  emailVerified DateTime?
  name          String?
  avatarUrl     String?

  // Auth providers
  appleId       String?          @unique
  googleId      String?          @unique

  // Security
  passwordHash  String?
  refreshToken  String?
  tokenVersion  Int              @default(0)

  // Account status
  isActive      Boolean          @default(true)
  isPremium     Boolean          @default(false)
  premiumUntil  DateTime?

  // Subscription (denormalized for fast access)
  subscriptionTier SubscriptionTier @default(FREE)

  // Stripe (for web payments)
  stripeCustomerId String?          @unique

  // User preferences
  customInstructions String?     @db.Text

  // Usage tracking
  promptCount   Int              @default(0)
  tokenUsage    BigInt           @default(0)

  // Timestamps
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastLoginAt   DateTime?

  // Relations
  sessions        Session[]
  prompts         Prompt[]
  apiKeys         ApiKey[]
  subscription    Subscription?
  apiSubscription ApiSubscription?
  supportTickets  SupportTicket[]

  // Indexes for performance at scale
  @@index([email])
  @@index([appleId])
  @@index([googleId])
  @@index([createdAt])
  @@index([isActive, isPremium])
  @@index([subscriptionTier])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId     String?
  deviceName   String?
  deviceType   String?  // ios, web, etc.
  ipAddress    String?
  userAgent    String?

  accessToken  String   @unique
  refreshToken String   @unique

  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
}

// ============================================================================
// PROMPT HISTORY - Optimized for high-volume writes and queries
// ============================================================================

model Prompt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Original input
  originalPrompt  String   @db.Text

  // Enhanced output
  enhancedPrompt  String   @db.Text

  // Metadata
  model           String   @default("deepseek-reasoner")
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(8192)
  modality        String   @default("text")  // text, image, video, audio, code, 3d

  // Usage stats
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  processingMs    Int      @default(0)

  // Organization
  title           String?
  tags            String[] @default([])
  isFavorite      Boolean  @default(false)
  isArchived      Boolean  @default(false)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Indexes for fast queries at scale
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isFavorite])
  @@index([userId, isArchived])
  @@index([userId, tags])
  @@index([createdAt(sort: Desc)])
}

// ============================================================================
// API KEYS - For programmatic access (Enterprise API)
// ============================================================================

model ApiKey {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  keyHash         String    @unique
  keyPrefix       String    // "pk_live_" or "pk_test_" + first 8 chars for identification

  // Permissions & Rate Limiting
  permissions     String[]  @default(["enhance"])
  rateLimit       Int       @default(60)  // Requests per minute

  // Enterprise Security Features
  allowedIps      String[]  @default([])  // IP whitelist (empty = all allowed)
  allowedOrigins  String[]  @default([])  // CORS origins whitelist
  requireSigning  Boolean   @default(false) // Require HMAC request signing
  signingSecret   String?   // Secret for HMAC signing (hashed)

  // Metadata
  description     String?
  environment     String    @default("production") // production, test

  // Usage tracking
  lastUsedAt      DateTime?
  lastUsedIp      String?
  totalRequests   BigInt    @default(0)

  // Security tracking
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?

  // Lifecycle
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  revokedAt       DateTime?
  revokedReason   String?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  usageRecords    ApiUsage[]
  auditLogs       ApiAuditLog[]

  @@index([userId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@index([isActive, userId])
}

// ============================================================================
// API USAGE - Track individual API requests for billing
// ============================================================================

model ApiUsage {
  id            String   @id @default(cuid())
  apiKeyId      String
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId        String

  // Request details
  endpoint      String
  method        String
  statusCode    Int

  // Token usage
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  latencyMs     Int      @default(0)

  // Enhancement details
  modality      String?

  // Client info
  ipAddress     String?
  userAgent     String?

  createdAt     DateTime @default(now())

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ============================================================================
// API SUBSCRIPTIONS - Enterprise API billing (separate from app subscriptions)
// ============================================================================

model ApiSubscription {
  id                    String                @id @default(cuid())
  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tier & Status
  tier                  ApiTier               @default(API_FREE)
  status                ApiSubscriptionStatus @default(ACTIVE)

  // Stripe Billing
  stripeSubscriptionId  String?               @unique
  stripeCustomerId      String?
  stripePriceId         String?

  // Quota Configuration
  includedRequests      Int                   @default(100)   // Requests included in plan
  overageRateCents      Int                   @default(1)     // Cost per 100 overage requests

  // Current Billing Period
  currentPeriodStart    DateTime              @default(now())
  currentPeriodEnd      DateTime
  currentPeriodUsage    Int                   @default(0)

  // Alert Configuration
  alertThresholds       Int[]                 @default([50, 80, 100]) // % thresholds for alerts
  alertsSentThisPeriod  Int[]                 @default([])            // Thresholds already alerted

  // Subscription Management
  cancelAtPeriodEnd     Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  alerts                UsageAlert[]

  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@index([tier, status])
}

// ============================================================================
// USAGE ALERTS - Quota warning notifications
// ============================================================================

model UsageAlert {
  id                String          @id @default(cuid())
  apiSubscriptionId String
  apiSubscription   ApiSubscription @relation(fields: [apiSubscriptionId], references: [id], onDelete: Cascade)
  userId            String

  // Alert details
  alertType         String          // QUOTA_WARNING, QUOTA_EXCEEDED, RATE_LIMIT_WARNING, SECURITY_ALERT
  threshold         Int?            // Percentage threshold that triggered alert
  currentUsage      Int?
  limit             Int?

  // Notification status
  emailSent         Boolean         @default(false)
  emailSentAt       DateTime?
  webhookSent       Boolean         @default(false)
  webhookSentAt     DateTime?

  // Alert metadata
  message           String
  severity          String          @default("info") // info, warning, critical
  metadata          Json?

  createdAt         DateTime        @default(now())

  @@index([apiSubscriptionId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([alertType, createdAt(sort: Desc)])
}

// ============================================================================
// USAGE ANALYTICS - For tracking and billing
// ============================================================================

model UsageRecord {
  id          String   @id @default(cuid())
  userId      String

  date        DateTime @db.Date
  promptCount Int      @default(0)
  tokenCount  BigInt   @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

// ============================================================================
// SYSTEM - Rate limiting and audit logs
// ============================================================================

model RateLimit {
  id         String   @id @default(cuid())
  identifier String   // userId or IP
  endpoint   String

  count      Int      @default(0)
  windowStart DateTime @default(now())

  @@unique([identifier, endpoint])
  @@index([identifier])
  @@index([windowStart])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  resourceId String?

  ipAddress String?
  userAgent String?

  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ============================================================================
// API AUDIT LOGS - Comprehensive API activity tracking for enterprise
// ============================================================================

model ApiAuditLog {
  id          String   @id @default(cuid())
  apiKeyId    String
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId      String

  // Request details
  action      String   // CREATE_KEY, ROTATE_KEY, REVOKE_KEY, API_CALL, AUTH_FAILURE, RATE_LIMIT, IP_BLOCKED
  endpoint    String?
  method      String?
  statusCode  Int?

  // Security context
  ipAddress   String
  userAgent   String?
  country     String?
  city        String?

  // Risk assessment
  riskLevel   String   @default("low") // low, medium, high, critical
  riskFactors String[] @default([])

  // Request/Response metadata
  requestId   String?
  latencyMs   Int?
  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([riskLevel, createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
}

// ============================================================================
// SUBSCRIPTIONS - In-App Purchase management
// ============================================================================

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Current subscription state
  tier                  SubscriptionTier   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)

  // App Store transaction tracking
  originalTransactionId String?            @unique
  productId             String?

  // Stripe (for web payments)
  stripeSubscriptionId  String?            @unique
  stripePriceId         String?
  cancelAtPeriodEnd     Boolean            @default(false)

  // Dates
  expiresAt             DateTime?
  trialEndDate          DateTime?
  gracePeriodEndDate    DateTime?

  // Trial tracking
  hasUsedTrial          Boolean            @default(false)
  isTrialing            Boolean            @default(false)

  // Auto-renewal
  autoRenewEnabled      Boolean            @default(true)
  autoRenewProductId    String?

  // Timestamps
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
  @@index([originalTransactionId])
  @@index([stripeSubscriptionId])
}

model AppStoreTransaction {
  id                    String   @id @default(cuid())
  userId                String

  // Transaction identifiers
  transactionId         String   @unique
  originalTransactionId String
  webOrderLineItemId    String?

  // Product info
  productId             String
  type                  String   // SUBSCRIPTION, CONSUMABLE, etc.

  // Dates
  purchaseDate          DateTime
  expirationDate        DateTime?
  revocationDate        DateTime?

  // Environment
  environment           String   // Production, Sandbox

  // Raw data for debugging
  signedTransactionInfo String?  @db.Text

  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([originalTransactionId])
  @@index([purchaseDate(sort: Desc)])
}

// ============================================================================
// DAILY USAGE - For quota tracking
// ============================================================================

model DailyUsage {
  id          String   @id @default(cuid())
  userId      String

  date        DateTime @db.Date
  promptCount Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

// ============================================================================
// TEMPLATES - Reusable prompt templates
// ============================================================================

model Template {
  id          String   @id @default(cuid())
  userId      String?  // null for built-in templates

  name        String
  content     String   @db.Text
  description String?
  category    String   @default("General")
  icon        String?  @default("doc.text")

  // Template type
  isBuiltIn   Boolean  @default(false)
  isPublic    Boolean  @default(false)

  // Usage tracking
  usageCount  Int      @default(0)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([category])
  @@index([isBuiltIn])
}

// ============================================================================
// COLLECTIONS - Organize prompts into folders
// ============================================================================

model Collection {
  id          String   @id @default(cuid())
  userId      String

  name        String
  description String?
  color       String   @default("#007AFF")
  icon        String   @default("folder.fill")

  // Prompt count (denormalized for fast access)
  promptCount Int      @default(0)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  prompts     PromptCollection[]

  @@index([userId, createdAt(sort: Desc)])
}

// Junction table for many-to-many prompt-collection relationship
model PromptCollection {
  id           String     @id @default(cuid())
  promptId     String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  addedAt      DateTime   @default(now())

  @@unique([promptId, collectionId])
  @@index([promptId])
  @@index([collectionId])
}

// ============================================================================
// WEBHOOK IDEMPOTENCY - Prevent duplicate processing of webhooks
// ============================================================================

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model WebhookIdempotencyKey {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique
  endpoint       String
  payload        Json?
  statusCode     Int?
  responseBody   Json?
  status         IdempotencyStatus @default(PROCESSING)
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@index([idempotencyKey])
  @@index([expiresAt])
  @@index([status])
}

// ============================================================================
// SUPPORT TICKETS - User support system
// ============================================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  ACCOUNT
  BILLING
  TECHNICAL
  FEATURE_REQUEST
  BUG_REPORT
  OTHER
}

model SupportTicket {
  id                String         @id @default(cuid())
  userId            String

  // Ticket details
  subject           String
  category          TicketCategory @default(OTHER)
  priority          TicketPriority @default(MEDIUM)
  status            TicketStatus   @default(OPEN)

  // Assigned support agent name (for display purposes)
  assignedAgentName String?

  // AI-generated summary from chat
  summary           String?        @db.Text

  // Timestamps
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  resolvedAt        DateTime?

  // Relations
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          SupportMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([priority])
  @@index([category])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Message content
  role      String        // 'user', 'assistant', 'agent' (human support)
  content   String        @db.Text

  // Metadata
  isFromAI  Boolean       @default(false)

  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ============================================================================
// DEVICE TOKENS - Push notification device registration
// ============================================================================

model DeviceToken {
  id          String   @id @default(cuid())
  userId      String

  // Device identification
  deviceToken String   @unique
  deviceId    String?  // Optional device UUID
  deviceType  String   @default("ios") // ios, android, web

  // APNs specific
  bundleId    String?
  environment String   @default("production") // production, sandbox

  // Status
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime @default(now())

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([deviceToken])
  @@index([isActive])
}

// ============================================================================
// PENDING ENHANCEMENTS - Track background enhancement jobs
// ============================================================================

model PendingEnhancement {
  id              String   @id @default(cuid())
  userId          String

  // Original request
  originalPrompt  String   @db.Text

  // Status
  status          String   @default("pending") // pending, processing, completed, failed

  // Result (when completed)
  enhancedPrompt  String?  @db.Text
  promptId        String?  // Reference to created Prompt

  // Error info (if failed)
  errorMessage    String?

  // Notification tracking
  notificationSent Boolean @default(false)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
}
