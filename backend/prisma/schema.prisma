generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  GRACE_PERIOD
}

// ============================================================================
// API SUBSCRIPTION ENUMS - For Enterprise API Access
// ============================================================================

enum ApiTier {
  API_FREE        // 100 requests/month, free
  API_STARTER     // 1,000 requests/month, $29/month
  API_PRO         // 10,000 requests/month, $99/month
  API_ENTERPRISE  // Unlimited, custom pricing
}

enum ApiSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

// ============================================================================
// USER MANAGEMENT - Scalable for millions of users
// ============================================================================

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  emailVerified DateTime?
  name          String?
  avatarUrl     String?

  // Auth providers
  appleId       String?          @unique
  googleId      String?          @unique

  // Security
  passwordHash  String?
  refreshToken  String?
  tokenVersion  Int              @default(0)

  // Account status
  isActive      Boolean          @default(true)
  isPremium     Boolean          @default(false)
  premiumUntil  DateTime?

  // Subscription (denormalized for fast access)
  subscriptionTier SubscriptionTier @default(FREE)

  // Stripe (for web payments)
  stripeCustomerId String?          @unique

  // User preferences
  customInstructions String?     @db.Text

  // Usage tracking
  promptCount   Int              @default(0)
  tokenUsage    BigInt           @default(0)

  // Timestamps
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastLoginAt   DateTime?

  // Relations
  sessions              Session[]
  prompts               Prompt[]
  threads               Thread[]
  subscription          Subscription?
  supportTickets        SupportTicket[]
  workflows             Workflow[]
  workflowExecutions    WorkflowExecution[]
  variationResults      VariationResult[]
  projectContexts       ProjectContext[]
  platformSettings      UserPlatformSettings[]
  sandboxTests          SandboxTest[]

  // Indexes for performance at scale
  @@index([email])
  @@index([appleId])
  @@index([googleId])
  @@index([createdAt])
  @@index([isActive, isPremium])
  @@index([subscriptionTier])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId     String?
  deviceName   String?
  deviceType   String?  // ios, web, etc.
  ipAddress    String?
  userAgent    String?

  accessToken  String   @unique
  refreshToken String   @unique

  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
}

// ============================================================================
// PROMPT HISTORY - Optimized for high-volume writes and queries
// ============================================================================

model Prompt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Original input
  originalPrompt  String   @db.Text

  // Enhanced output
  enhancedPrompt  String   @db.Text

  // Metadata
  model           String   @default("deepseek-reasoner")
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(8192)
  modality        String   @default("text")  // text, image, video, audio, code, 3d

  // Usage stats
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  processingMs    Int      @default(0)

  // Organization
  title           String?
  tags            String[] @default([])
  isFavorite      Boolean  @default(false)
  isArchived      Boolean  @default(false)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  variations      PromptVariation[]
  contextUsages   ContextUsage[]
  sandboxTests    SandboxTest[]

  // Indexes for fast queries at scale
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isFavorite])
  @@index([userId, isArchived])
  @@index([userId, tags])
  @@index([createdAt(sort: Desc)])
}

// ============================================================================
// DEVELOPERS - Separate accounts for API access (Enterprise)
// ============================================================================

model Developer {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String

  // Profile
  name            String?
  company         String?
  website         String?

  // Security
  refreshToken    String?
  tokenVersion    Int       @default(0)

  // Account status
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)

  // Usage tracking
  totalApiCalls   BigInt    @default(0)

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  // Relations
  apiKeys         ApiKey[]
  apiSubscription ApiSubscription?

  @@index([email])
  @@index([isActive])
}

// ============================================================================
// API KEYS - For programmatic access (Enterprise API)
// ============================================================================

model ApiKey {
  id              String    @id @default(cuid())
  developerId     String
  developer       Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  name            String
  keyHash         String    @unique
  keyPrefix       String    // "pk_live_" or "pk_test_" + first 8 chars for identification

  // Permissions & Rate Limiting
  permissions     String[]  @default(["enhance"])
  rateLimit       Int       @default(60)  // Requests per minute

  // Metadata
  description     String?
  environment     String    @default("production") // production, test

  // Usage tracking
  lastUsedAt      DateTime?
  totalRequests   BigInt    @default(0)

  // Lifecycle
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  revokedAt       DateTime?
  revokedReason   String?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  usageRecords    ApiUsage[]

  @@index([developerId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@index([isActive, developerId])
}

// ============================================================================
// API USAGE - Track individual API requests for billing
// ============================================================================

model ApiUsage {
  id            String   @id @default(cuid())
  apiKeyId      String
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  developerId   String

  // Request details
  endpoint      String
  method        String
  statusCode    Int

  // Token usage
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  latencyMs     Int      @default(0)

  // Enhancement details
  modality      String?

  // Client info
  ipAddress     String?
  userAgent     String?

  createdAt     DateTime @default(now())

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([developerId, createdAt(sort: Desc)])
}

// ============================================================================
// API SUBSCRIPTIONS - Enterprise API billing (separate from app subscriptions)
// ============================================================================

model ApiSubscription {
  id                    String                @id @default(cuid())
  developerId           String                @unique
  developer             Developer             @relation(fields: [developerId], references: [id], onDelete: Cascade)

  // Tier & Status
  tier                  ApiTier               @default(API_FREE)
  status                ApiSubscriptionStatus @default(ACTIVE)

  // Stripe Billing
  stripeSubscriptionId  String?               @unique
  stripeCustomerId      String?
  stripePriceId         String?

  // Quota Configuration
  includedRequests      Int                   @default(100)   // Requests included in plan
  overageRateCents      Int                   @default(1)     // Cost per 100 overage requests

  // Current Billing Period
  currentPeriodStart    DateTime              @default(now())
  currentPeriodEnd      DateTime
  currentPeriodUsage    Int                   @default(0)

  // Subscription Management
  cancelAtPeriodEnd     Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@index([tier, status])
}

// ============================================================================
// USAGE ANALYTICS - For tracking and billing
// ============================================================================

model UsageRecord {
  id          String   @id @default(cuid())
  userId      String

  date        DateTime @db.Date
  promptCount Int      @default(0)
  tokenCount  BigInt   @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

// ============================================================================
// SYSTEM - Rate limiting and audit logs
// ============================================================================

model RateLimit {
  id         String   @id @default(cuid())
  identifier String   // userId or IP
  endpoint   String

  count      Int      @default(0)
  windowStart DateTime @default(now())

  @@unique([identifier, endpoint])
  @@index([identifier])
  @@index([windowStart])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  resourceId String?

  ipAddress String?
  userAgent String?

  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ============================================================================
// SUBSCRIPTIONS - In-App Purchase management
// ============================================================================

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Current subscription state
  tier                  SubscriptionTier   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)

  // App Store transaction tracking
  originalTransactionId String?            @unique
  productId             String?

  // Stripe (for web payments)
  stripeSubscriptionId  String?            @unique
  stripePriceId         String?
  cancelAtPeriodEnd     Boolean            @default(false)

  // Dates
  expiresAt             DateTime?
  trialEndDate          DateTime?
  gracePeriodEndDate    DateTime?

  // Trial tracking
  hasUsedTrial          Boolean            @default(false)
  isTrialing            Boolean            @default(false)

  // Auto-renewal
  autoRenewEnabled      Boolean            @default(true)
  autoRenewProductId    String?

  // Timestamps
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
  @@index([originalTransactionId])
  @@index([stripeSubscriptionId])
}

model AppStoreTransaction {
  id                    String   @id @default(cuid())
  userId                String

  // Transaction identifiers
  transactionId         String   @unique
  originalTransactionId String
  webOrderLineItemId    String?

  // Product info
  productId             String
  type                  String   // SUBSCRIPTION, CONSUMABLE, etc.

  // Dates
  purchaseDate          DateTime
  expirationDate        DateTime?
  revocationDate        DateTime?

  // Environment
  environment           String   // Production, Sandbox

  // Raw data for debugging
  signedTransactionInfo String?  @db.Text

  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([originalTransactionId])
  @@index([purchaseDate(sort: Desc)])
}

// ============================================================================
// DAILY USAGE - For quota tracking
// ============================================================================

model DailyUsage {
  id          String   @id @default(cuid())
  userId      String

  date        DateTime @db.Date
  promptCount Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

// ============================================================================
// TEMPLATES - Reusable prompt templates
// ============================================================================

model Template {
  id          String   @id @default(cuid())
  userId      String?  // null for built-in templates

  name        String
  content     String   @db.Text
  description String?
  category    String   @default("General")
  icon        String?  @default("doc.text")

  // Template type
  isBuiltIn   Boolean  @default(false)
  isPublic    Boolean  @default(false)

  // Usage tracking
  usageCount  Int      @default(0)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([category])
  @@index([isBuiltIn])
}

// ============================================================================
// COLLECTIONS - Organize prompts into folders
// ============================================================================

model Collection {
  id          String   @id @default(cuid())
  userId      String

  name        String
  description String?
  color       String   @default("#007AFF")
  icon        String   @default("folder.fill")

  // Prompt count (denormalized for fast access)
  promptCount Int      @default(0)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  prompts     PromptCollection[]

  @@index([userId, createdAt(sort: Desc)])
}

// Junction table for many-to-many prompt-collection relationship
model PromptCollection {
  id           String     @id @default(cuid())
  promptId     String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  addedAt      DateTime   @default(now())

  @@unique([promptId, collectionId])
  @@index([promptId])
  @@index([collectionId])
}

// ============================================================================
// WEBHOOK IDEMPOTENCY - Prevent duplicate processing of webhooks
// ============================================================================

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model WebhookIdempotencyKey {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique
  endpoint       String
  payload        Json?
  statusCode     Int?
  responseBody   Json?
  status         IdempotencyStatus @default(PROCESSING)
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@index([idempotencyKey])
  @@index([expiresAt])
  @@index([status])
}

// ============================================================================
// SUPPORT TICKETS - User support system
// ============================================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  ACCOUNT
  BILLING
  TECHNICAL
  FEATURE_REQUEST
  BUG_REPORT
  OTHER
}

model SupportTicket {
  id                String         @id @default(cuid())
  userId            String

  // Ticket details
  subject           String
  category          TicketCategory @default(OTHER)
  priority          TicketPriority @default(MEDIUM)
  status            TicketStatus   @default(OPEN)

  // Assigned support agent name (for display purposes)
  assignedAgentName String?

  // AI-generated summary from chat
  summary           String?        @db.Text

  // Timestamps
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  resolvedAt        DateTime?

  // Relations
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          SupportMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([priority])
  @@index([category])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Message content
  role      String        // 'user', 'assistant', 'agent' (human support)
  content   String        @db.Text

  // Metadata
  isFromAI  Boolean       @default(false)

  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ============================================================================
// DEVICE TOKENS - Push notification device registration
// ============================================================================

model DeviceToken {
  id          String   @id @default(cuid())
  userId      String

  // Device identification
  deviceToken String   @unique
  deviceId    String?  // Optional device UUID
  deviceType  String   @default("ios") // ios, android, web

  // APNs specific
  bundleId    String?
  environment String   @default("production") // production, sandbox

  // Status
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime @default(now())

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([deviceToken])
  @@index([isActive])
}

// ============================================================================
// PENDING ENHANCEMENTS - Track background enhancement jobs
// ============================================================================

model PendingEnhancement {
  id              String   @id @default(cuid())
  userId          String

  // Original request
  originalPrompt  String   @db.Text

  // Status
  status          String   @default("pending") // pending, processing, completed, failed

  // Result (when completed)
  enhancedPrompt  String?  @db.Text
  promptId        String?  // Reference to created Prompt

  // Error info (if failed)
  errorMessage    String?

  // Notification tracking
  notificationSent Boolean @default(false)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
}

// ============================================================================
// CONVERSATION THREADS - Multi-turn prompt enhancement sessions
// ============================================================================

model Thread {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  modality    String       @default("text")
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  turns       ThreadTurn[]

  @@index([userId, updatedAt(sort: Desc)])
}

model ThreadTurn {
  id              String   @id @default(cuid())
  threadId        String
  thread          Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  turnIndex       Int
  originalPrompt  String   @db.Text
  enhancedPrompt  String   @db.Text
  model           String   @default("deepseek-chat")
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  processingMs    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([threadId, turnIndex])
}

// ============================================================================
// WORKFLOW MANAGEMENT - Multi-step prompt workflows
// ============================================================================

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Workflow {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?               @db.Text
  status          WorkflowStatus        @default(DRAFT)
  metadata        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  
  steps           WorkflowStep[]
  executions      WorkflowExecution[]
  
  @@index([userId, status])
  @@index([userId, updatedAt(sort: Desc)])
}

model WorkflowStep {
  id                String    @id @default(cuid())
  workflowId        String
  workflow          Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder         Int
  name              String
  promptTemplate    String    @db.Text
  contextRequired   String[]
  outputFormat      String?
  validationRules   Json?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([workflowId, stepOrder])
  @@index([workflowId])
}

model WorkflowExecution {
  id            String    @id @default(cuid())
  workflowId    String
  workflow      Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String
  currentStep   Int       @default(0)
  stepResults   Json?
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  metadata      Json?
  
  @@index([workflowId, status])
  @@index([userId, startedAt(sort: Desc)])
}

// ============================================================================
// PROMPT VARIATIONS - A/B testing and version management
// ============================================================================

enum VariationStatus {
  DRAFT
  TESTING
  WINNER
  ARCHIVED
}

model PromptVariation {
  id              String            @id @default(cuid())
  promptId        String
  prompt          Prompt            @relation(fields: [promptId], references: [id], onDelete: Cascade)
  variantName     String
  variantPrompt   String            @db.Text
  status          VariationStatus   @default(DRAFT)
  testPercentage  Int               @default(50)
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  results         VariationResult[]
  
  @@index([promptId, status])
  @@unique([promptId, variantName])
}

model VariationResult {
  id            String            @id @default(cuid())
  variationId   String
  variation     PromptVariation   @relation(fields: [variationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String
  selected      Boolean           @default(false)
  rating        Int?
  feedback      String?           @db.Text
  metadata      Json?
  createdAt     DateTime          @default(now())
  
  @@index([variationId, createdAt])
  @@index([sessionId])
}

// ============================================================================
// PROJECT CONTEXT - Reusable context for prompts
// ============================================================================

model ProjectContext {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?         @db.Text
  contextData   Json
  tags          String[]
  isGlobal      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  usages        ContextUsage[]
  
  @@index([userId, name])
  @@index([userId, isGlobal])
}

model ContextUsage {
  id          String          @id @default(cuid())
  contextId   String
  context     ProjectContext  @relation(fields: [contextId], references: [id], onDelete: Cascade)
  promptId    String
  prompt      Prompt          @relation(fields: [promptId], references: [id], onDelete: Cascade)
  usedAt      DateTime        @default(now())
  metadata    Json?
  
  @@unique([contextId, promptId])
  @@index([promptId])
  @@index([contextId])
}

// ============================================================================
// PLATFORM PRESETS - Platform-specific optimization
// ============================================================================

enum PlatformType {
  CHATGPT
  CLAUDE
  GEMINI
  PERPLEXITY
  MIDJOURNEY
  DALLE
  STABLE_DIFFUSION
  GITHUB_COPILOT
  SORA
  RUNWAY
  SUNO
  UDIO
  FLUX
  PIKA
  KLING
  MUSICGEN
  MESHY
  TRIPO3D
  CUSTOM
}

model PlatformPreset {
  id                    String                  @id @default(cuid())
  platform              PlatformType
  name                  String
  description           String?                 @db.Text
  systemPrompt          String?                 @db.Text
  formatGuidelines      Json
  tokenLimits           Json
  bestPractices         String[]
  examplePrompts        Json?
  isOfficial            Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  
  userSettings          UserPlatformSettings[]
  
  @@unique([platform, name])
  @@index([platform, isOfficial])
}

model UserPlatformSettings {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  presetId        String
  preset          PlatformPreset  @relation(fields: [presetId], references: [id], onDelete: Cascade)
  customSettings  Json?
  isDefault       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@unique([userId, presetId])
  @@index([userId, isDefault])
}

// ============================================================================
// SANDBOX TESTING - Test prompts against multiple platforms
// ============================================================================

model SandboxTest {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId          String?
  prompt            Prompt?               @relation(fields: [promptId], references: [id], onDelete: SetNull)
  testPrompt        String                @db.Text
  platforms         PlatformType[]
  parameters        Json?
  status            String                @default("pending")
  scheduledFor      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  
  results           PlatformTestResult[]
  
  @@index([userId, status])
  @@index([status, scheduledFor])
}

model PlatformTestResult {
  id              String        @id @default(cuid())
  testId          String
  test            SandboxTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  platform        PlatformType
  response        String?       @db.Text
  error           String?       @db.Text
  latencyMs       Int?
  tokenCount      Int?
  cost            Float?
  metadata        Json?
  createdAt       DateTime      @default(now())
  
  @@unique([testId, platform])
  @@index([testId])
}
