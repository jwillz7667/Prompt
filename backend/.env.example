# Database (Railway PostgreSQL)
# Add connection pooling params for production (adjust based on your Railway plan)
# connection_limit: max connections per instance (25-50 recommended)
# pool_timeout: max wait time for connection (30s recommended)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&connection_limit=25&pool_timeout=30"

# Direct connection for migrations (bypasses connection pooler)
DATABASE_DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET="your-access-secret-min-64-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-64-chars"

# Apple Sign In
APPLE_CLIENT_ID="com.yourapp.prompt"
APPLE_TEAM_ID="YOUR_TEAM_ID"
APPLE_KEY_ID="YOUR_KEY_ID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# DeepSeek API (primary enhancement provider — required)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
# Model id for all DeepSeek calls. Legacy deepseek-chat / deepseek-reasoner
# are deprecated upstream 2026-07-24 and alias to deepseek-v4-flash
# non-thinking / thinking modes. Every request sets the `thinking` parameter
# explicitly because V4 Flash defaults thinking ON and bills the
# chain-of-thought as output tokens.
# DEEPSEEK_MODEL="deepseek-v4-flash"

# Optional compare providers: each key activates that provider in the
# PRO multi-provider compare endpoint (/api/v1/prompts/compare).
# Model ids are overridable so a deprecation is an ops change, not a deploy.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# DEEPSEEK_COMPARE_MODEL="deepseek-v4-flash"
# ANTHROPIC_COMPARE_MODEL="claude-sonnet-5"
# OPENAI_COMPARE_MODEL="gpt-4.1"
# GEMINI_COMPARE_MODEL="gemini-2.5-flash"

# Server
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="*"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Apple App Store Server API (for subscription verification)
# Get these from App Store Connect > Users and Access > Keys
APPLE_ISSUER_ID="your-issuer-id-uuid"
APPLE_KEY_ID="your-key-id"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_BUNDLE_ID="com.res.promptomizer"
APPLE_APP_ID="your-app-id"

# Subscription Settings
FREE_TRIAL_DAYS=7

# Web App Webhook Secret (for Stripe webhook forwarding from Next.js)
# Generate with: openssl rand -base64 32
BACKEND_WEBHOOK_SECRET="your-webhook-secret-here"

# =============================================================================
# ENTERPRISE SCALING (Optional - for handling thousands of users)
# =============================================================================

# Redis (for caching, rate limiting, job queues)
# Get from Railway, Upstash, or Redis Cloud
REDIS_URL="redis://default:password@host:6379"
# Or individual settings:
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# Logging
LOG_LEVEL="info"  # trace, debug, info, warn, error, fatal

# Monitoring (optional - for error tracking)
SENTRY_DSN=""

# Resend Email Service (https://resend.com)
# Tip: Use a subdomain like mail.promptomize.app for better deliverability
RESEND_API_KEY="re_your_resend_api_key"
# Svix signing secret for the Resend inbound-email webhook (support ticket replies).
# Without it the /webhooks/resend/inbound route rejects all requests in production.
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_secret"
FROM_EMAIL="Promptomize <hello@promptomize.app>"
SUPPORT_EMAIL="support@promptomize.app"
APP_URL="https://promptomize.app"

# Advanced Rate Limiting (per-tier settings)
RATE_LIMIT_FREE_PROMPTS=10      # prompts per minute for free tier
RATE_LIMIT_PRO_PROMPTS=50       # prompts per minute for pro tier
RATE_LIMIT_PREMIUM_PROMPTS=200  # prompts per minute for premium tier
