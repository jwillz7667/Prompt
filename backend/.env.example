# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET="your-access-secret-min-64-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-64-chars"

# Apple Sign In
APPLE_CLIENT_ID="com.yourapp.prompt"
APPLE_TEAM_ID="YOUR_TEAM_ID"
APPLE_KEY_ID="YOUR_KEY_ID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# DeepSeek API
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# Server
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="*"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Apple App Store Server API (for subscription verification)
# Get these from App Store Connect > Users and Access > Keys
APPLE_ISSUER_ID="your-issuer-id-uuid"
APPLE_KEY_ID="your-key-id"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_BUNDLE_ID="com.res.promptomizer"
APPLE_APP_ID="your-app-id"

# Subscription Settings
FREE_TRIAL_DAYS=7

# Web App Webhook Secret (for Stripe webhook forwarding from Next.js)
# Generate with: openssl rand -base64 32
BACKEND_WEBHOOK_SECRET="your-webhook-secret-here"
