# Database (Railway PostgreSQL)
# Add connection pooling params for production (adjust based on your Railway plan)
# connection_limit: max connections per instance (25-50 recommended)
# pool_timeout: max wait time for connection (30s recommended)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&connection_limit=25&pool_timeout=30"

# Direct connection for migrations (bypasses connection pooler)
DATABASE_DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET="your-access-secret-min-64-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-64-chars"

# Apple Sign In
APPLE_CLIENT_ID="com.yourapp.prompt"
APPLE_TEAM_ID="YOUR_TEAM_ID"
APPLE_KEY_ID="YOUR_KEY_ID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---------------------------------------------------------------------------
# LLM gateway (backend/src/features/llm) — every AI text/vision call
# ---------------------------------------------------------------------------
# Ordered failover chain. Providers missing their key/base URL are skipped with
# one warning at boot. Failover happens only before the first token reaches the
# client. See docs/AI-OPERATIONS.md for the runbook.
LLM_PROVIDER_CHAIN="deepseek,openrouter"
# Home GPU first, cloud as fallback:
# LLM_PROVIDER_CHAIN="local,deepseek,openrouter"

# DeepSeek direct (primary). LLM_DEEPSEEK_API_KEY falls back to DEEPSEEK_API_KEY.
LLM_DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
# LLM_DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Used exactly as written (falls back to DEEPSEEK_MODEL). Only the retired ids
# deepseek-chat / deepseek-reasoner / deepseek-v4-flash are aliased to
# deepseek-flash. Boot warns if the id is missing from GET <base>/models.
# LLM_DEEPSEEK_MODEL="deepseek-flash"
# LLM_DEEPSEEK_SUPPORTS_IMAGES=true

# OpenRouter (automatic fallback).
LLM_OPENROUTER_API_KEY=""
# LLM_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# LLM_OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash"
# JSON sent verbatim as the request "provider" routing object.
# LLM_OPENROUTER_PROVIDER_PREFS='{"sort":"throughput","allow_fallbacks":true}'
# LLM_OPENROUTER_SUPPORTS_IMAGES=false

# Self-hosted OpenAI-compatible endpoint (vLLM behind Cloudflare Tunnel).
# All three of BASE_URL / API_KEY / MODEL are required or the provider is skipped.
# LLM_LOCAL_BASE_URL="https://llm.example.com/v1"
# LLM_LOCAL_API_KEY=""
# LLM_LOCAL_MODEL="qwen3-32b-awq"
# Cloudflare Access service token (set both or neither).
# LLM_LOCAL_CF_ACCESS_CLIENT_ID=""
# LLM_LOCAL_CF_ACCESS_CLIENT_SECRET=""
# LLM_LOCAL_SUPPORTS_IMAGES=false

# Deadlines. TTFT = time to first token; exceeding it fails over to the next provider.
# LLM_TTFT_TIMEOUT_MS=15000
# LLM_IDLE_TIMEOUT_MS=60000
# LLM_TOTAL_TIMEOUT_MS=180000
# Circuit breaker cooldown after 401/402 (provider-wide failures).
# LLM_BREAKER_LONG_COOLDOWN_MS=300000
# Extra attempts on the LAST remaining provider for 429/5xx/timeouts (0 disables).
# LLM_LAST_PROVIDER_RETRIES=1

# ---------------------------------------------------------------------------
# General-purpose chat (backend/src/features/chat, /api/v1/chat)
# ---------------------------------------------------------------------------
# Output cap per reply; a reply that hits it is saved with status "truncated".
# CHAT_MAX_OUTPUT_TOKENS=2048
# History sent per turn. Estimated per script: Latin ~4 chars/token, CJK
# 1 token per character, other non-Latin scripts 2 chars/token.
# CHAT_CONTEXT_TOKEN_BUDGET=12000
# Messages per user per UTC day (Redis usage:chat:v1:<userId>:<date>; 429 FAIR_USE_LIMIT).
# CHAT_DAILY_MESSAGE_LIMIT=150
# Moderation of user messages (before the model) and replies (before saving)
# uses the free moderation endpoint and needs OPENAI_API_KEY (below). App
# Review requires it: without the key the boot log reports it DISABLED (error
# level in production). Fails open on an outage. "false" disables it.
# CHAT_MODERATION_ENABLED=true

# Vision: "deepseek" (default) routes image turns through the gateway to
# image-capable providers; "openai" uses a dedicated OpenAI vision model.
# PROMPT_VISION_PROVIDER="deepseek"
# DEEPSEEK_VISION_MODEL="deepseek-flash"
# OPENAI_VISION_STANDARD_MODEL="gpt-4.1-mini"
# OPENAI_VISION_MAX_MODEL="gpt-4.1"

# Optional compare providers: each key activates that provider in the
# PRO multi-provider compare endpoint (/api/v1/prompts/compare).
# Model ids are overridable so a deprecation is an ops change, not a deploy.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# DEEPSEEK_COMPARE_MODEL="deepseek-flash"
# ANTHROPIC_COMPARE_MODEL="claude-sonnet-5"
# OPENAI_COMPARE_MODEL="gpt-4.1"
# GEMINI_COMPARE_MODEL="gemini-2.5-flash"

# Reflection-loop prompt optimizer (/api/v1/optimize) — mini-GEPA pipeline on
# DeepSeek (docs/plans/promptomize-reflection-loop-spec.md). New surface ships
# dark: anything but "true" (the default) makes the routes return 404. Jobs
# run on BullMQ when Redis is configured, inline in-process otherwise.
REFLECTION_LOOP_ENABLED=false

# Server
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="*"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Apple App Store Server API (subscription status reconciliation, refund and
# renewal history). In-App Purchase key from App Store Connect > Users and
# Access > Integrations > In-App Purchase. The APPLE_IAP_* names win; the
# unprefixed APPLE_ISSUER_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY are legacy
# fallbacks (APPLE_KEY_ID / APPLE_PRIVATE_KEY are also the APNs key).
APPLE_IAP_ISSUER_ID="your-issuer-id-uuid"
APPLE_IAP_KEY_ID="your-iap-key-id"
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_BUNDLE_ID="com.res.promptomizer"
APPLE_APP_ID="your-app-id"
# Accept Sandbox-signed transactions on this backend (App Review and TestFlight
# purchases are always Sandbox). Defaults to true; "false" rejects them all.
# APPLE_ACCEPT_SANDBOX_TRANSACTIONS="true"
# A Sandbox purchase unlocks Premium only for accounts younger than this many
# days (App Review signs in with a fresh Apple ID) or listed testers. 0 = list only.
# APPLE_SANDBOX_ACCOUNT_MAX_AGE_DAYS=14
# Comma-separated user ids (internal testers) whose Sandbox purchases always unlock.
# APPLE_SANDBOX_ALLOWED_USER_IDS=""

# Sign in with Apple token revocation on account deletion (guideline 5.1.1(v)).
# Key from Certificates, Identifiers & Profiles > Keys with "Sign in with Apple"
# enabled; uses APPLE_TEAM_ID and the identity token's client id. Set all three
# or none (a partial set fails boot; none logs that revocation is disabled).
# APPLE_SIWA_KEY_ID="your-siwa-key-id"
# APPLE_SIWA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 32 random bytes, base64 (openssl rand -base64 32); encrypts stored refresh tokens.
# APPLE_SIWA_TOKEN_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Hard paywall and daily usage (src/services/subscriptionService.ts)
# ---------------------------------------------------------------------------
# Rollout: ships "true" with the iOS hard-paywall build. Rollback: set "false"
# in Railway and restart; non-subscribers get FREE_DAILY_PROMPT_LIMIT again.
# Cleanup: after one full release with the flag untouched, delete the flag,
# the legacy-allowance branch and FREE_DAILY_PROMPT_LIMIT.
# HARD_PAYWALL_ENABLED="true"
# Legacy free generations per UTC day; used only while HARD_PAYWALL_ENABLED=false.
# FREE_DAILY_PROMPT_LIMIT=10
# Subscriber fair-use ceiling: provider generations per UTC day, reserved
# atomically on DailyUsage before each call (429 FAIR_USE_LIMIT).
# PREMIUM_DAILY_GENERATION_SOFT_CAP=300
# Support-assistant replies per user per UTC day (429 SUPPORT_LIMIT_REACHED).
# Support needs no subscription, so this is the only cap on that route.
# SUPPORT_AI_DAILY_LIMIT=20


# Web App Webhook Secret (for Stripe webhook forwarding from Next.js)
# Generate with: openssl rand -base64 32
BACKEND_WEBHOOK_SECRET="your-webhook-secret-here"

# =============================================================================
# ENTERPRISE SCALING (Optional - for handling thousands of users)
# =============================================================================

# Redis (for caching, rate limiting, job queues)
# Get from Railway, Upstash, or Redis Cloud
REDIS_URL="redis://default:password@host:6379"
# Or individual settings:
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# Logging
LOG_LEVEL="info"  # trace, debug, info, warn, error, fatal

# Monitoring (optional - for error tracking)
SENTRY_DSN=""

# Resend Email Service (https://resend.com)
# Tip: Use a subdomain like mail.promptomize.app for better deliverability
RESEND_API_KEY="re_your_resend_api_key"
# Svix signing secret for the Resend inbound-email webhook (support ticket replies).
# Without it the /webhooks/resend/inbound route rejects all requests in production.
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_secret"
FROM_EMAIL="Promptomize <hello@promptomize.app>"
SUPPORT_EMAIL="support@promptomize.app"
APP_URL="https://promptomize.app"

# Advanced Rate Limiting (per-tier settings)
RATE_LIMIT_FREE_PROMPTS=10      # prompts per minute for free tier
RATE_LIMIT_PRO_PROMPTS=50       # prompts per minute for pro tier
RATE_LIMIT_PREMIUM_PROMPTS=200  # prompts per minute for premium tier

# Developer API (separate B2B product, outside the app paywall; see
# docs/adr/0001-developer-api-free-tier.md)
# Free-tier model calls per developer per month (0 = paid plans only).
# API_FREE_MONTHLY_REQUESTS=25
# Developer signups allowed per client IP per hour.
# DEVELOPER_SIGNUPS_PER_IP_PER_HOUR=5
