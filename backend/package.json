{
  "name": "@promptomize/backend",
  "version": "2.0.0",
  "private": true,
  "description": "Promptomize backend — Express + TypeScript REST API with Prisma, Redis, BullMQ, and Socket.IO.",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": {
    "name": "Justin Williams",
    "email": "support@promptomize.app",
    "url": "https://promptomize.app"
  },
  "homepage": "https://github.com/jwillz7667/Prompt#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwillz7667/Prompt.git",
    "directory": "backend"
  },
  "bugs": {
    "url": "https://github.com/jwillz7667/Prompt/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,json,md}\" \"prisma/**/*.prisma\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md}\" \"prisma/**/*.prisma\" \"*.{json,md}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "clean": "rimraf dist .tsbuildinfo",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@apple/app-store-server-library": "^2.0.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/yaml": "^1.9.6",
    "apple-signin-auth": "^1.7.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.67.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.14.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.25.0",
    "p-limit": "^7.3.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "redis": "^5.10.0",
    "resend": "^6.12.2",
    "socket.io": "^4.8.3",
    "stripe": "^20.3.0",
    "uuid": "^10.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/handlebars": "^4.0.40",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
