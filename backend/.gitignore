# =============================================================================
# Promptomize Backend — .gitignore
# Layered on top of the repository-root .gitignore.
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.eslintcache
.prettiercache
.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Prisma local artifacts
prisma/*.db
prisma/*.db-journal
prisma/migrations/dev.db*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Sentry
.sentryclirc
